# App Config
PROJECT_NAME="Voltix Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Secrets
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="voltix_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/voltix_db"

# Redis Cache Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# Supabase Authentication Setup
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# CORS Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
